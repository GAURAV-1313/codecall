{
  "name": "codecall",
  "version": "1.5.1",
  "license": "MIT",
  "type": "module",
  "description": "Understand the code your AI agent writes: a 4-minute quiz on each change, step-by-step flow traces, and planted-bug debugging drills. Claude Code, Codex, Cursor and more. No API key.",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "agent-skills",
    "ai-coding",
    "code-comprehension",
    "learning",
    "quiz",
    "debugging",
    "interview-prep",
    "developer-education",
    "backend"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GAURAV-1313/codecall.git"
  },
  "bugs": {
    "url": "https://github.com/GAURAV-1313/codecall/issues"
  },
  "homepage": "https://github.com/GAURAV-1313/codecall#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "plugins/codecall",
    "README.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "main": "./dist/public.js",
  "types": "./dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    }
  },
  "bin": {
    "codecall": "dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "postinstall": "node ./dist/install-skill.js --global-only"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
